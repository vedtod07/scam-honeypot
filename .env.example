# LLM configuration for Scam Honeypot
# Set these to use a live LLM (e.g. Featherless AI, OpenAI-compatible endpoint).
# Leave unset to run in Replay mode (uses cache/cached_run.json with zero LLM calls).

LLM_BASE_URL=https://api.featherless.ai/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
